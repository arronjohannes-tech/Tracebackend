{
  "name": "tracebackend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python scripts/serve.py",
    "test": "node --test tests/*.test.mjs",
    "backend:dev": "npm --prefix backend run dev",
    "backend:migrate": "npm --prefix backend run migrate",
    "backend:test": "npm --prefix backend test",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "check": "npm --prefix backend run typecheck && npm --prefix backend test && npm --prefix mobile run typecheck && npm --prefix mobile test && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "dotenv": "^18.0.4"
  }
}
