NODE_ENV=development
HOST=0.0.0.0
PORT=4300
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tracebackend
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=tracebackend
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32-byte key, base64 encoded (example generation: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
CONFIG_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
PUBLIC_BASE_URL=http://127.0.0.1:4300
STORAGE_DIR=./storage
ADMIN_ORIGIN=http://127.0.0.1:4300
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-me-before-first-migration

# Local development only; production requires s3 and HTTPS.
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=tracebackend-documents
# S3_REGION=eu-central-1
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# AWS_ACCESS_KEY_ID=provide-through-secret-manager
# AWS_SECRET_ACCESS_KEY=provide-through-secret-manager
